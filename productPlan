**DATABASE SCHEMA**

```sql
-- sending accounts
CREATE TABLE accounts (
    id INTEGER PRIMARY KEY,
    email TEXT,
    app_password TEXT,
    domain TEXT,
    daily_limit INTEGER DEFAULT 20,
    emails_sent_today INTEGER DEFAULT 0,
    status TEXT DEFAULT 'warming',
    created_at DATETIME DEFAULT CURRENT_TIMESTAMP
);

-- warmup pool accounts
CREATE TABLE warmup_accounts (
    id INTEGER PRIMARY KEY,
    email TEXT,
    app_password TEXT,
    daily_volume INTEGER DEFAULT 5,
    active INTEGER DEFAULT 1
);

-- warmup log
CREATE TABLE warmup_log (
    id INTEGER PRIMARY KEY,
    from_email TEXT,
    to_email TEXT,
    subject TEXT,
    sent_at DATETIME DEFAULT CURRENT_TIMESTAMP,
    replied INTEGER DEFAULT 0
);

-- campaigns
CREATE TABLE campaigns (
    id INTEGER PRIMARY KEY,
    name TEXT,
    account_id INTEGER,
    status TEXT DEFAULT 'draft',
    daily_limit INTEGER DEFAULT 20,
    send_days TEXT DEFAULT 'mon,tue,wed,thu,fri',
    send_start_hour INTEGER DEFAULT 9,
    send_end_hour INTEGER DEFAULT 17,
    created_at DATETIME DEFAULT CURRENT_TIMESTAMP
);

-- sequence steps
CREATE TABLE sequence_steps (
    id INTEGER PRIMARY KEY,
    campaign_id INTEGER,
    step_number INTEGER,
    subject TEXT,
    body TEXT,
    delay_days INTEGER DEFAULT 0
);

-- leads
CREATE TABLE leads (
    id INTEGER PRIMARY KEY,
    campaign_id INTEGER,
    first_name TEXT,
    last_name TEXT,
    email TEXT,
    company TEXT,
    website TEXT,
    personalized_line TEXT,
    current_step INTEGER DEFAULT 1,
    next_send_date DATE,
    status TEXT DEFAULT 'active',
    created_at DATETIME DEFAULT CURRENT_TIMESTAMP
);

-- sent log
CREATE TABLE sent_log (
    id INTEGER PRIMARY KEY,
    lead_id INTEGER,
    campaign_id INTEGER,
    step_number INTEGER,
    subject TEXT,
    sent_at DATETIME DEFAULT CURRENT_TIMESTAMP,
    bounced INTEGER DEFAULT 0
);

-- replies
CREATE TABLE replies (
    id INTEGER PRIMARY KEY,
    lead_id INTEGER,
    received_at DATETIME DEFAULT CURRENT_TIMESTAMP,
    pushed_to_hubspot INTEGER DEFAULT 0
);
```

